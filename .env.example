# Copy to `.env` in this directory. `./start-ide-local.sh` loads it on startup.
# Variables already set in your shell are not overwritten.

# GitHub OAuth App client ID (Settings → GitHub). Required to connect GitHub.
# Create an OAuth App at https://github.com/settings/developers
# The IDE uses GitHub's device-code flow; no localhost callback URL is required.
GITHUB_OAUTH_CLIENT_ID=

# Auth mode for the local server: local | public_pebble | public_custom
# IDE_AUTH_MODE=local

# Optional SMTP when sending magic-link mail (typically public_custom)
# SMTP_RELAY=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=always
# IDE_MAIL_FROM=noreply@localhost

# Optional Cloudflare Turnstile keys for public login
# IDE_TURNSTILE_SITE_KEY=
# IDE_TURNSTILE_SECRET_KEY=

# Optional embedded-emulator overrides
# ELM_PEBBLE_EMBEDDED_EMULATOR=true
# ELM_PEBBLE_QEMU_BIN=
# ELM_PEBBLE_QEMU_IMAGE_ROOT=
