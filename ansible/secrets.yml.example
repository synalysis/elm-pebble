# Copy to secrets.yml (gitignored). Leave a value empty only when you do not have it.
# The database password is generated on the server the first time.
# When secret_key_base or ide_email_hash_pepper is set, that value is copied
# and is not replaced with a new one.
acme_email: ""
smtp_relay: ""
smtp_port: "587"
smtp_username: ""
smtp_password: ""
smtp_tls: always
smtp_ssl: "false"
ide_auth_mode: public_custom
ide_repo_adapter: postgres
phx_host: ""
ide_mail_from: ""
ide_email_hash_pepper: ""
secret_key_base: ""
github_oauth_client_id: ""
wasm_build_on_start: "0"
