PHX_SERVER=true
PHX_HOST={{ elm_pebble_public_host }}
PORT=4000
IDE_AUTH_MODE={{ ide_auth_mode }}
IDE_REPO_ADAPTER={{ ide_repo_adapter | default('postgres') }}
DATABASE_URL=postgres://{{ postgres_user }}:{{ elm_pebble_postgres_password }}@postgres:5432/{{ postgres_db }}
SECRET_KEY_BASE={{ elm_pebble_secret_key_base }}
IDE_EMAIL_HASH_PEPPER={{ elm_pebble_email_pepper }}
IDE_DATA_ROOT=/var/lib/ide
PROJECTS_ROOT=/var/lib/ide/workspace_projects
SETTINGS_FILE=/var/lib/ide/config/settings.json
PEBBLE_SDK_VERSION=latest
INSTALL_PEBBLE_SDK=1
ELM_PEBBLE_SDK_INSTALL_ROOT=/var/lib/ide/.pebble-sdk/SDKs/current
ELM_PEBBLE_QEMU_BIN=/var/lib/ide/.pebble-sdk/SDKs/current/toolchain/bin/qemu-pebble
ELM_PEBBLE_PYPKJS_BIN=/opt/pipx/venvs/pebble-tool/bin/pypkjs
ELM_PEBBLE_QEMU_IMAGE_ROOT=/var/lib/ide/.pebble-sdk/SDKs/current/sdk-core/pebble
ELM_PEBBLE_QEMU_DATA_ROOT=/usr/share/qemu
ELM_PEBBLE_QEMU_DOWNLOAD_IMAGES=1
ELM_PEBBLE_WASM_BUILD_ON_START={{ wasm_build_on_start | default(0) }}
POOL_SIZE=10
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ elm_pebble_postgres_password }}
POSTGRES_DB={{ postgres_db }}
SMTP_RELAY={{ smtp_relay }}
SMTP_PORT={{ smtp_port }}
SMTP_USERNAME={{ smtp_username }}
SMTP_PASSWORD={{ smtp_password }}
SMTP_TLS={{ smtp_tls }}
SMTP_SSL={{ smtp_ssl }}
IDE_MAIL_FROM={{ ide_mail_from if ide_mail_from | length > 0 else 'noreply@' ~ elm_pebble_domain }}
{% if github_oauth_client_id | default('') | length > 0 %}
GITHUB_OAUTH_CLIENT_ID={{ github_oauth_client_id }}
{% endif %}
