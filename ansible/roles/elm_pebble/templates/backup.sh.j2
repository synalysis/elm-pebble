#!/bin/bash
set -euo pipefail

dest=/var/backups/elm-pebble
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "$dest"
docker exec elm-pebble-postgres pg_dump -U {{ postgres_user }} -d {{ postgres_db }} | gzip > "$dest/postgres-$stamp.sql.gz"
chmod 600 "$dest/postgres-$stamp.sql.gz"
find "$dest" -name 'postgres-*.sql.gz' -mtime +7 -delete
