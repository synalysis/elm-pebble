module Main exposing (main)

import Html exposing (Html, text)


flag : Bool -> String
flag value =
    if value then
        "1"

    else
        "0"


main : Html String
main =
    text
        (String.join "|"
            [ "sl:" ++ flag (String.slice 7 9 "snakes on a plane!" == "on")
            , "sn:" ++ flag (String.slice 0 -7 "snakes on a plane!" == "snakes on a")
            , "se:" ++ flag (String.slice -6 -1 "snakes on a plane!" == "plane")
            , "pad:" ++ flag (String.pad 5 ' ' "1" == "  1  ")
            , "pad2:" ++ flag (String.pad 5 ' ' "11" == "  11 ")
            , "pl:" ++ flag (String.padLeft 5 '0' "7" == "00007")
            , "pr:" ++ flag (String.padRight 5 '0' "7" == "70000")
            , "l0:" ++ flag (String.left 0 "Mulder" == "")
            , "ln:" ++ flag (String.left -1 "Mulder" == "")
            , "rt:" ++ flag (String.right 2 "Mulder" == "er")
            , "rtn:" ++ flag (String.right -1 "Mulder" == "")
            , "dl:" ++ flag (String.dropLeft -1 "abc" == "abc")
            , "drt:" ++ flag (String.dropRight 2 "Mulder" == "Muld")
            , "drn:" ++ flag (String.dropRight -1 "abc" == "abc")
            , "ix:" ++ flag (String.indexes "i" "Mississippi" == [ 1, 4, 7, 10 ])
            , "ixs:" ++ flag (String.indexes "ss" "Mississippi" == [ 2, 5 ])
            , "ixo:" ++ flag (String.indexes "aa" "aaa" == [ 0 ])
            , "ixe:" ++ flag (String.indexes "" "abc" == [])
            , "all:" ++ flag (String.all (\_ -> False) "")
            , "any:" ++ flag (not (String.any (\_ -> True) ""))
            , "w:" ++ flag (String.words "How are \t you? \n Good?" == [ "How", "are", "you?", "Good?" ])
            , "we:" ++ flag (String.words "" == [ "" ])
            , "li:" ++ flag (String.lines "a\r\nb\nc" == [ "a", "b", "c" ])
            , "ti:" ++ flag (String.toInt "123" == Just 123)
            , "tp:" ++ flag (String.toInt "+42" == Just 42)
            , "tf:" ++ flag (String.toInt "3.1" == Nothing)
            , "ffh:" ++ flag (String.fromFloat 0.5 == "0.5")
            , "ffi:" ++ flag (String.fromFloat 123 == "123")
            , "tfl:" ++ flag (String.toFloat "3.1" == Just 3.1)
            , "tfe:" ++ flag (String.toFloat "1e2" == Just 100.0)
            , "tfx:" ++ flag (String.toFloat "31a" == Nothing && String.toFloat "0x10" == Nothing)
            , "tsp:" ++ flag (String.toFloat " 3" == Nothing)
            , "tdt:" ++ flag (String.toFloat ".5" == Just 0.5)
            , "up:" ++ flag (String.toUpper "éclair" == "ÉCLAIR")
            , "lo:" ++ flag (String.toLower "Σ" == "σ")
            , "ss:" ++ flag (String.toUpper "ß" == "SS")
            , "len:" ++ flag (String.length "éclair" == 6)
            , "ixu:" ++ flag (String.indexes "c" "éclair" == [ 1 ])
            , "fc:" ++ flag (String.fromChar 'é' == "é")
            , "pdu:" ++ flag (String.pad 5 '.' "é" == "..é..")
            , "sp:" ++ flag (String.split "" "éclair" == [ "é", "c", "l", "a", "i", "r" ])
            , "spe:" ++ flag (String.split "" "" == [])
            , "spd:" ++ flag (String.split "/" "home/evan/Desktop/" == [ "home", "evan", "Desktop", "" ])
            , "re:" ++ flag (String.replace "" "-" "abc" == "a-b-c")
            , "reu:" ++ flag (String.replace "" "-" "éclair" == "é-c-l-a-i-r")
            , "red:" ++ flag (String.replace "." "-" "Json.Decode.succeed" == "Json-Decode-succeed")
            , "tr:" ++ flag (String.trim " \tx\n " == "x")
            , "rev:" ++ flag (String.reverse "stressed" == "desserts")
            , "revu:" ++ flag (String.reverse "éclair" == "rialcé")
            , "rep:" ++ flag (String.repeat 3 "ha" == "hahaha")
            , "rep0:" ++ flag (String.repeat 0 "ha" == "")
            , "repn:" ++ flag (String.repeat -1 "ha" == "")
            , "uc:" ++ flag (String.uncons "abc" == Just ( 'a', "bc" ))
            , "uce:" ++ flag (String.uncons "" == Nothing)
            , "co:" ++ flag (String.contains "the" "theory" && not (String.contains "hat" "theory"))
            , "coe:" ++ flag (String.contains "" "test")
            , "sw:" ++ flag (String.startsWith "the" "theory" && not (String.startsWith "ory" "theory"))
            , "ew:" ++ flag (String.endsWith "ory" "theory" && not (String.endsWith "the" "theory"))
            , "fl:" ++ flag (String.fromList [ 'a', 'b', 'c' ] == "abc")
            , "tl:" ++ flag (String.toList "abc" == [ 'a', 'b', 'c' ])
            , "cn:" ++ flag (String.cons 'T' "he" == "The")
            , "jn:" ++ flag (String.join "a" [ "H", "w", "ii", "n" ] == "Hawaiian")
            , "cc:" ++ flag (String.concat [ "never", "the", "less" ] == "nevertheless")
            , "ie:" ++ flag (String.isEmpty "" && not (String.isEmpty "the world"))
            , "tlf:" ++ flag (String.trimLeft "  hats  \n" == "hats  \n")
            , "trf:" ++ flag (String.trimRight "  hats  \n" == "  hats")
            , "tn:" ++ flag (String.trim "\u{00A0}x\u{00A0}" == "x")
            , "sm:" ++ flag (String.map (\c -> if c == '/' then '.' else c) "a/b/c" == "a.b.c")
            , "sf:" ++ flag (String.filter Char.isDigit "R2-D2" == "22")
            , "sfl:" ++ flag (String.foldl String.cons "" "time" == "emit")
            , "sfr:" ++ flag (String.foldr String.cons "" "time" == "time")
            , "sa:" ++ flag (String.any Char.isDigit "90210" && String.any Char.isDigit "R2-D2" && not (String.any Char.isDigit "heart"))
            , "sal:" ++ flag (String.all Char.isDigit "90210" && not (String.all Char.isDigit "R2-D2") && not (String.all Char.isDigit "heart"))
            , "slu:" ++ flag (String.toLocaleUpper "éclair" == "ÉCLAIR")
            , "sll:" ++ flag (String.toLocaleLower "Σ" == "σ")
            , "idc:" ++ flag (String.indices "ss" "Mississippi" == [ 2, 5 ])
            , "fi:" ++ flag (String.fromInt 42 == "42")
            , "fin:" ++ flag (String.fromInt -3 == "-3")
            , "fia:" ++ flag (String.fromInt 42 == "42" && String.fromInt -3 == "-3")
            , "upx:" ++ flag (String.toUpper "čaša" == "ČAŠA")
            , "lox:" ++ flag (String.toLower "ČAŠA" == "čaša")
            , "upy:" ++ flag (String.toUpper "я" == "Я")
            ]
        )
